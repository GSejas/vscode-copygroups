{
  "name": "vscode-copygroups",
  "displayName": "Copy Groups",
  "description": "Manage and share reusable file sets with AI-ready context filtering",
  "version": "0.1.7",
  "publisher": "GSejas",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clipboard",
    "file-management",
    "groups",
    "ai",
    "context",
    "python"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GSejas/vscode-copygroups"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --target=node16",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/jest": "^28.1.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "@typescript-eslint/parser": "^5.30.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.18.0",
    "jest": "^28.1.0",
    "ts-jest": "^28.0.5",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "minimatch": "^5.1.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "copygroups.createGroup",
        "title": "Copy Groups: Create New Group",
        "icon": "$(add)"
      },
      {
        "command": "copygroups.addToGroup",
        "title": "Copy Groups: Add File to Group",
        "icon": "$(file-add)"
      },
      {
        "command": "copygroups.copyGroup",
        "title": "Copy Groups: Copy to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "copygroups.copySelectedFiles",
        "title": "Copy Selected Files",
        "icon": "$(files)"
      },
      {
        "command": "copygroups.copyFolder",
        "title": "Copy Folder Contents",
        "icon": "$(folder-opened)"
      },
      {
        "command": "copygroups.copyContext",
        "title": "Copy Context",
        "icon": "$(copy)"
      },
      {
        "command": "copygroups.deleteGroup",
        "title": "Copy Groups: Delete Group",
        "icon": "$(trash)"
      },
      {
        "command": "copygroups.toggleBookmark",
        "title": "Copy Groups: Toggle Bookmark",
        "icon": "$(bookmark)"
      },
      {
        "command": "copygroups.renameGroup",
        "title": "Copy Groups: Rename Group"
      },
      {
        "command": "copygroups.setGroupMode",
        "title": "Copy Groups: Set Context Mode"
      },
      {
        "command": "copygroups.setGroupPreprompt",
        "title": "Copy Groups: Set Preprompt"
      },
      {
        "command": "copygroups.removeFileFromGroup",
        "title": "Copy Groups: Remove File from Group"
      },
      {
        "command": "copygroups.history.recopy",
        "title": "Re-copy to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "copygroups.history.toggleFavourite",
        "title": "Toggle Favourite",
        "icon": "$(star)"
      },
      {
        "command": "copygroups.history.addNote",
        "title": "Add / Edit Note"
      },
      {
        "command": "copygroups.history.delete",
        "title": "Delete Entry",
        "icon": "$(trash)"
      },
      {
        "command": "copygroups.history.modifyMode",
        "title": "Change Context Mode"
      },
      {
        "command": "copygroups.history.clear",
        "title": "Copy Groups: Clear History (keep favourites)"
      },
      {
        "command": "copygroups.syncViews",
        "title": "Sync Views",
        "icon": "$(sync)"
      },
      {
        "command": "copygroups.openWebviewInEditor",
        "title": "Copy Groups: Open Webview in Editor"
      }
    ],
    "viewsContainers": {
      "sidebar": [
        {
          "id": "copygroups",
          "title": "Copy Groups",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "copygroups": [
        {
          "id": "copygroups.groups",
          "name": "Groups",
          "when": "true"
        },
        {
          "id": "copygroups.history",
          "name": "Copy History",
          "when": "true"
        },
        {
          "id": "copygroups.sidebar",
          "name": "Copy Groups (Webview)",
          "type": "webview",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copygroups.createGroup",
          "when": "view == copygroups.groups",
          "group": "navigation"
        },
        {
          "command": "copygroups.syncViews",
          "when": "view == copygroups.groups",
          "group": "navigation"
        },
        {
          "command": "copygroups.syncViews",
          "when": "view == copygroups.history",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "copygroups.copyContext",
          "group": "1_modification@1",
          "when": "resourceScheme == file || explorerResourceIsFolder"
        },
        {
          "command": "copygroups.addToGroup",
          "group": "1_modification@2",
          "when": "resourceScheme == file || explorerResourceIsFolder"
        },
        {
          "command": "copygroups.copyFolder",
          "group": "1_modification@3",
          "when": "explorerResourceIsFolder"
        }
      ],
      "view/item/context": [
        {
          "command": "copygroups.copyGroup",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "inline@1"
        },
        {
          "command": "copygroups.deleteGroup",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "inline@2"
        },
        {
          "command": "copygroups.copyGroup",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "1_copy@1"
        },
        {
          "command": "copygroups.toggleBookmark",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "1_copy@2"
        },
        {
          "command": "copygroups.renameGroup",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "2_edit@1"
        },
        {
          "command": "copygroups.setGroupMode",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "2_edit@2"
        },
        {
          "command": "copygroups.setGroupPreprompt",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "2_edit@3"
        },
        {
          "command": "copygroups.deleteGroup",
          "when": "view == copygroups.groups && viewItem =~ /groupItem/",
          "group": "3_delete@1"
        },
        {
          "command": "copygroups.history.recopy",
          "when": "view == copygroups.history && viewItem == historyEntry",
          "group": "1_copy@1"
        },
        {
          "command": "copygroups.history.toggleFavourite",
          "when": "view == copygroups.history && viewItem == historyEntry",
          "group": "1_copy@2"
        },
        {
          "command": "copygroups.history.addNote",
          "when": "view == copygroups.history && viewItem == historyEntry",
          "group": "2_meta@1"
        },
        {
          "command": "copygroups.history.modifyMode",
          "when": "view == copygroups.history && viewItem == historyEntry",
          "group": "2_meta@2"
        },
        {
          "command": "copygroups.history.delete",
          "when": "view == copygroups.history && viewItem == historyEntry",
          "group": "3_delete@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copygroups.createGroup",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "copygroups.addToGroup",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "copygroups.copyGroup",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c"
      }
    ]
  }
}
